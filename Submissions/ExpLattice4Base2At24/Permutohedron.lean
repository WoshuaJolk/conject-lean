/-- Every exponent tuple in the box `{0, …, 3}^4`. -/
def BOX : List T :=
  (List.range 4).flatMap fun a0 => (List.range 4).flatMap fun a1 => (List.range 4).flatMap fun a2 => (List.range 4).map fun a3 => (a0, a1, a2, a3)

theorem cp_covers : ∀ t ∈ EX, t ∈ CP.map Prod.fst := by decide

theorem cp_ok : ∀ r ∈ CP,
    (∀ u ∈ EX, u ≠ r.1 → dt r.2.1 u ≤ r.2.2) ∧ r.2.2 < dt r.2.1 r.1 := by decide

theorem bad_covers : ∀ t ∈ BOX, t ∈ EX ∨ t ∈ BAD.map Prod.fst := by decide

theorem bad_ok : ∀ r ∈ BAD,
    (∀ u ∈ EX, dt r.2.1 u ≤ r.2.2) ∧ r.2.2 < dt r.2.1 r.1 := by decide

theorem box_0 : ∀ u ∈ EX, dt (1, 0, 0, 0) u ≤ 8 := by decide
theorem box_1 : ∀ u ∈ EX, dt (0, 1, 0, 0) u ≤ 8 := by decide
theorem box_2 : ∀ u ∈ EX, dt (0, 0, 1, 0) u ≤ 8 := by decide
theorem box_3 : ∀ u ∈ EX, dt (0, 0, 0, 1) u ≤ 8 := by decide

theorem card_ok : EX.toFinset.card = 24 := by decide

/-- The lattice point of `L₄(2)` with exponent tuple `t`. -/
def rp (t : T) : Fin 4 → ℝ := ![2 ^ t.1, 2 ^ t.2.1, 2 ^ t.2.2.1, 2 ^ t.2.2.2]

/-- The real linear functional with integer coefficient tuple `a`. -/
def LF (a : ℤ × ℤ × ℤ × ℤ) (x : Fin 4 → ℝ) : ℝ :=
  (a.1 : ℝ) * x 0 + (a.2.1 : ℝ) * x 1 + (a.2.2.1 : ℝ) * x 2 + (a.2.2.2 : ℝ) * x 3

/-- The vertex set. -/
def VS : Set (Fin 4 → ℝ) := rp '' (↑EX.toFinset : Set T)

/-- The exponential lattice `L₄(2)`. -/
def S4 : Set (Fin 4 → ℝ) := {x : Fin 4 → ℝ | ∀ i, ∃ n : ℕ, x i = (2 : ℝ) ^ n}

theorem LF_rp (a : ℤ × ℤ × ℤ × ℤ) (t : T) : LF a (rp t) = (dt a t : ℝ) := by
  simp only [LF, rp, dt, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
  push_cast
  ring

theorem convex_LF (a : ℤ × ℤ × ℤ × ℤ) (r : ℝ) :
    Convex ℝ {x : Fin 4 → ℝ | LF a x ≤ r} := by
  intro x hx y hy s u hs hu hsu
  simp only [Set.mem_setOf_eq, LF, Pi.add_apply, Pi.smul_apply, smul_eq_mul] at *
  have key : (a.1 : ℝ) * (s * x 0 + u * y 0) + (a.2.1 : ℝ) * (s * x 1 + u * y 1) + (a.2.2.1 : ℝ) * (s * x 2 + u * y 2) + (a.2.2.2 : ℝ) * (s * x 3 + u * y 3) = s * ((a.1 : ℝ) * x 0 + (a.2.1 : ℝ) * x 1 + (a.2.2.1 : ℝ) * x 2 + (a.2.2.2 : ℝ) * x 3) + u * ((a.1 : ℝ) * y 0 + (a.2.1 : ℝ) * y 1 + (a.2.2.1 : ℝ) * y 2 + (a.2.2.2 : ℝ) * y 3) := by ring
  have hr : s * r + u * r = r := by rw [← add_mul, hsu, one_mul]
  rw [key]
  have h1 := mul_le_mul_of_nonneg_left hx hs
  have h2 := mul_le_mul_of_nonneg_left hy hu
  linarith

theorem hull_le {a : ℤ × ℤ × ℤ × ℤ} {r : ℝ} {S : Set (Fin 4 → ℝ)}
    (hS : ∀ x ∈ S, LF a x ≤ r) {p : Fin 4 → ℝ} (hp : p ∈ convexHull ℝ S) : LF a p ≤ r :=
  convexHull_min hS (convex_LF a r) hp

theorem not_mem_hull {a : ℤ × ℤ × ℤ × ℤ} {r : ℝ} {S : Set (Fin 4 → ℝ)}
    (hS : ∀ x ∈ S, LF a x ≤ r) {p : Fin 4 → ℝ} (hp : r < LF a p) :
    p ∉ convexHull ℝ S := fun h => absurd (hull_le hS h) (not_le.mpr hp)

theorem two_pow_inj {a b : ℕ} (h : (2 : ℝ) ^ a = 2 ^ b) : a = b := by
  have h' : ((2 ^ a : ℕ) : ℝ) = ((2 ^ b : ℕ) : ℝ) := by push_cast; exact h
  exact Nat.pow_right_injective (le_refl 2) (Nat.cast_injective h')

theorem two_pow_le {a : ℕ} (h : (2 : ℝ) ^ a ≤ 8) : a ≤ 3 := by
  by_contra hc
  have hk : 4 ≤ a := by omega
  have hpow : (2 : ℝ) ^ 4 ≤ 2 ^ a := pow_le_pow_right₀ (by norm_num) hk
  norm_num at hpow
  linarith

theorem rp_injOn : Set.InjOn rp (↑EX.toFinset : Set T) := by
  intro s _ t _ h
  have h0 : (2 : ℝ) ^ s.1 = 2 ^ t.1 := by
    have := congrFun h 0; simpa [rp] using this
  have e0 := two_pow_inj h0
  have h1 : (2 : ℝ) ^ s.2.1 = 2 ^ t.2.1 := by
    have := congrFun h 1; simpa [rp] using this
  have e1 := two_pow_inj h1
  have h2 : (2 : ℝ) ^ s.2.2.1 = 2 ^ t.2.2.1 := by
    have := congrFun h 2; simpa [rp] using this
  have e2 := two_pow_inj h2
  have h3 : (2 : ℝ) ^ s.2.2.2 = 2 ^ t.2.2.2 := by
    have := congrFun h 3; simpa [rp] using this
  have e3 := two_pow_inj h3
  obtain ⟨s0, s1, s2, s3⟩ := s
  obtain ⟨t0, t1, t2, t3⟩ := t
  simp_all

theorem mem_VS {t : T} (ht : t ∈ EX) : rp t ∈ VS := ⟨t, by simpa using ht, rfl⟩

theorem LF_le_of_mem {a : ℤ × ℤ × ℤ × ℤ} {c : ℤ} (h : ∀ u ∈ EX, dt a u ≤ c) :
    ∀ x ∈ VS, LF a x ≤ (c : ℝ) := by
  rintro x ⟨t, ht, rfl⟩
  rw [LF_rp]
  exact_mod_cast h t (by simpa using ht)

theorem LF_le_of_mem_erase {a : ℤ × ℤ × ℤ × ℤ} {c : ℤ} {v : T}
    (h : ∀ u ∈ EX, u ≠ v → dt a u ≤ c) : ∀ x ∈ VS \ {rp v}, LF a x ≤ (c : ℝ) := by
  rintro x ⟨⟨t, ht, rfl⟩, hne⟩
  rw [LF_rp]
  refine Int.cast_le.mpr (h t (by simpa using ht) ?_)
  rintro rfl
  exact hne rfl

theorem VS_finite : VS.Finite := (EX.toFinset.finite_toSet).image rp

theorem VS_ncard : VS.ncard = 24 := by
  rw [VS, Set.InjOn.ncard_image rp_injOn, Set.ncard_coe_finset, card_ok]

theorem VS_subset : VS ⊆ S4 := by
  rintro x ⟨t, -, rfl⟩ i
  fin_cases i
  · exact ⟨t.1, by simp [rp]⟩
  · exact ⟨t.2.1, by simp [rp]⟩
  · exact ⟨t.2.2.1, by simp [rp]⟩
  · exact ⟨t.2.2.2, by simp [rp]⟩

theorem VS_convexPosition : ∀ v ∈ VS, v ∉ convexHull ℝ (VS \ {v}) := by
  rintro v ⟨t, ht, rfl⟩
  have htEX : t ∈ EX := by simpa using ht
  obtain ⟨r, hrCP, hr1⟩ := List.mem_map.mp (cp_covers t htEX)
  obtain ⟨hle, hgt⟩ := cp_ok r hrCP
  subst hr1
  exact not_mem_hull (LF_le_of_mem_erase hle) (by rw [LF_rp]; exact_mod_cast hgt)

theorem VS_empty : convexHull ℝ VS ∩ S4 ⊆ VS := by
  rintro p ⟨hp, hpS⟩
  obtain ⟨n0, hn0⟩ := hpS 0
  obtain ⟨n1, hn1⟩ := hpS 1
  obtain ⟨n2, hn2⟩ := hpS 2
  obtain ⟨n3, hn3⟩ := hpS 3
  have hpe : p = rp (n0, n1, n2, n3) := by
    funext i; fin_cases i <;> simp [rp, hn0, hn1, hn2, hn3]
  have bx0 : LF (1, 0, 0, 0) p ≤ ((8 : ℤ) : ℝ) :=
    hull_le (LF_le_of_mem box_0) hp
  have bx1 : LF (0, 1, 0, 0) p ≤ ((8 : ℤ) : ℝ) :=
    hull_le (LF_le_of_mem box_1) hp
  have bx2 : LF (0, 0, 1, 0) p ≤ ((8 : ℤ) : ℝ) :=
    hull_le (LF_le_of_mem box_2) hp
  have bx3 : LF (0, 0, 0, 1) p ≤ ((8 : ℤ) : ℝ) :=
    hull_le (LF_le_of_mem box_3) hp
  have e0 : n0 ≤ 3 := by
    refine two_pow_le ?_
    rw [← hn0]; simpa [LF] using bx0
  have e1 : n1 ≤ 3 := by
    refine two_pow_le ?_
    rw [← hn1]; simpa [LF] using bx1
  have e2 : n2 ≤ 3 := by
    refine two_pow_le ?_
    rw [← hn2]; simpa [LF] using bx2
  have e3 : n3 ≤ 3 := by
    refine two_pow_le ?_
    rw [← hn3]; simpa [LF] using bx3
  have hbox : (n0, n1, n2, n3) ∈ BOX := by
    simp only [BOX, List.mem_flatMap, List.mem_map, List.mem_range]
    exact ⟨n0, by omega, n1, by omega, n2, by omega, n3, by omega, rfl⟩
  rcases bad_covers _ hbox with hin | hbad
  · rw [hpe]; exact mem_VS hin
  · exfalso
    obtain ⟨r, hrBAD, hr1⟩ := List.mem_map.mp hbad
    obtain ⟨hle, hgt⟩ := bad_ok r hrBAD
    refine not_mem_hull (LF_le_of_mem hle) ?_ hp
    rw [hpe, ← hr1, LF_rp]
    exact_mod_cast hgt

/-- **`h(L₄(2)) ≥ 24`.**  The permutohedron of `(2⁰, 2¹, 2², 2³)` is an empty polytope of
`{2ⁿ : n ∈ ℕ₀}⁴`, beating the published `5 · 2^(d-2) = 20`. -/
theorem proof :
    ∃ V : Set (Fin 4 → ℝ),
      (V.Finite ∧
        V ⊆ {x : Fin 4 → ℝ | ∀ i, ∃ n : ℕ, x i = (2 : ℝ) ^ n} ∧
        (∀ v ∈ V, v ∉ convexHull ℝ (V \ {v})) ∧
        convexHull ℝ V ∩ {x : Fin 4 → ℝ | ∀ i, ∃ n : ℕ, x i = (2 : ℝ) ^ n} ⊆ V) ∧
      V.ncard = 24 :=
  ⟨VS, ⟨VS_finite, VS_subset, VS_convexPosition, VS_empty⟩, VS_ncard⟩

end Submissions.ExpLattice4Base2At24.Permutohedron
