private theorem u_coord_star (i : Fin 14) (r : Fin 3) : star (u i r) = u i r := by
  simp [u, uZ, star_intCast]
private theorem w_coord_star (i : Fin 14) (r : Fin 4) : star (w i r) = w i r := by
  simp [w, wZ, star_intCast]
private theorem z_coord_star (i : Fin 14) (r : Fin 4) : star (z i r) = z i r := by
  simp [z, zZ, star_intCast]
private theorem ip3_symm (i j : Fin 14) : ip3 (u i) (u j) = ip3 (u j) (u i) := by
  simp only [ip3]; refine Finset.sum_congr rfl fun r _ => ?_
  rw [u_coord_star i r, u_coord_star j r, mul_comm]
private theorem ip4_w_symm (i j : Fin 14) : ip4 (w i) (w j) = ip4 (w j) (w i) := by
  simp only [ip4]; refine Finset.sum_congr rfl fun r _ => ?_
  rw [w_coord_star i r, w_coord_star j r, mul_comm]
private theorem ip4_z_symm (i j : Fin 14) : ip4 (z i) (z j) = ip4 (z j) (z i) := by
  simp only [ip4]; refine Finset.sum_congr rfl fun r _ => ?_
  rw [z_coord_star i r, z_coord_star j r, mul_comm]

theorem pairwise_ortho (i j : Fin 14) (hij : i ≠ j) :
    ip3 (u i) (u j) * ip4 (w i) (w j) * ip4 (z i) (z j) = 0 := by
  rcases lt_trichotomy i.val j.val with h | h | h
  · exact pairwise_ortho_lt' i j h
  · exact (hij (Fin.ext h)).elim
  · have h' := pairwise_ortho_lt' j i h
    rw [ip3_symm i j, ip4_w_symm i j, ip4_z_symm i j]; exact h'

theorem u_ne (i : Fin 14) : u i ≠ 0 := by
  fin_cases i <;> first
    | exact u_ne_0 | exact u_ne_1 | exact u_ne_2 | exact u_ne_3
    | exact u_ne_4 | exact u_ne_5 | exact u_ne_6 | exact u_ne_7
    | exact u_ne_8 | exact u_ne_9 | exact u_ne_10 | exact u_ne_11
    | exact u_ne_12 | exact u_ne_13
theorem w_ne (i : Fin 14) : w i ≠ 0 := by
  fin_cases i <;> first
    | exact w_ne_0 | exact w_ne_1 | exact w_ne_2 | exact w_ne_3
    | exact w_ne_4 | exact w_ne_5 | exact w_ne_6 | exact w_ne_7
    | exact w_ne_8 | exact w_ne_9 | exact w_ne_10 | exact w_ne_11
    | exact w_ne_12 | exact w_ne_13
theorem z_ne (i : Fin 14) : z i ≠ 0 := by
  fin_cases i <;> first
    | exact z_ne_0 | exact z_ne_1 | exact z_ne_2 | exact z_ne_3
    | exact z_ne_4 | exact z_ne_5 | exact z_ne_6 | exact z_ne_7
    | exact z_ne_8 | exact z_ne_9 | exact z_ne_10 | exact z_ne_11
    | exact z_ne_12 | exact z_ne_13

private theorem killγ {x y z : ℂ} (hx : x ≠ 0) (hy : y ≠ 0) (h : x * y * z = 0) : z = 0 := by
  rcases mul_eq_zero.1 h with h1 | h1
  · exact absurd h1 (mul_ne_zero hx hy)
  · exact h1
private theorem killγ2 {x z : ℂ} (hx : x ≠ 0) (h : x * z = 0) : z = 0 :=
  (mul_eq_zero.1 h).resolve_left hx
private theorem cvec4_ne {c0 c1 c2 c3 : ℂ}
    (hc : (![c0, c1, c2, c3] : Fin 4 → ℂ) ≠ 0)
    (h : c0 = 0 ∧ c1 = 0 ∧ c2 = 0 ∧ c3 = 0) : False := by
  apply hc; funext r; fin_cases r <;> simp [h]
private theorem avec3_ne {a0 a1 a2 : ℂ}
    (ha : (![a0, a1, a2] : Fin 3 → ℂ) ≠ 0)
    (h : a0 = 0 ∧ a1 = 0 ∧ a2 = 0) : False := by
  apply ha; funext r; fin_cases r <;> simp [h]

private def αU6 (a0 a1 a2 : ℂ) : Fin 6 → ℂ
  | ⟨0, _⟩ => ((2) : ℂ) * a0 + ((2) : ℂ) * a1 + ((2) : ℂ) * a2
  | ⟨1, _⟩ => ((3) : ℂ) * a0 + ((1) : ℂ) * a1 + ((-4) : ℂ) * a2
  | ⟨2, _⟩ => ((2) : ℂ) * a0 + ((-2) : ℂ) * a1 + ((1) : ℂ) * a2
