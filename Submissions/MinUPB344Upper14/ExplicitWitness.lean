  | ⟨0, _⟩ => ((2) : ℂ) * b0 + ((0) : ℂ) * b1 + ((2) : ℂ) * b2
  | ⟨1, _⟩ => ((0) : ℂ) * b0 + ((0) : ℂ) * b1 + ((2) : ℂ) * b2
