abbrev C3 := Fin 3 → ℂ
abbrev C4 := Fin 4 → ℂ
def ip3 (x y : C3) : ℂ := ∑ r, star (x r) * y r
def ip4 (x y : C4) : ℂ := ∑ r, star (x r) * y r

def uZ : Fin 14 → Fin 3 → ℤ
  | ⟨0, _⟩ => ![2, 2, 2]
  | ⟨1, _⟩ => ![3, 1, -4]
  | ⟨2, _⟩ => ![2, -2, 1]
