private theorem star_u (i : Fin 14) (r : Fin 3) : star (u i r) = u i r := by
  simp [u, uZ, star_intCast]
private theorem star_w (i : Fin 14) (r : Fin 4) : star (w i r) = w i r := by
  simp [w, wZ, star_intCast]
private theorem star_z (i : Fin 14) (r : Fin 4) : star (z i r) = z i r := by
  simp [z, zZ, star_intCast]
private theorem ip3_eq (i : Fin 14) (a : Fin 3 → ℂ) :
    ip3 (u i) a = ∑ r, u i r * a r := by
  simp only [ip3]; refine Finset.sum_congr rfl fun r _ => ?_; rw [star_u i r]
private theorem ip4w_eq (i : Fin 14) (b : Fin 4 → ℂ) :
    ip4 (w i) b = ∑ r, w i r * b r := by
  simp only [ip4]; refine Finset.sum_congr rfl fun r _ => ?_; rw [star_w i r]
private theorem ip4z_eq (i : Fin 14) (c : Fin 4 → ℂ) :
    ip4 (z i) c = ∑ r, z i r * c r := by
  simp only [ip4]; refine Finset.sum_congr rfl fun r _ => ?_; rw [star_z i r]
private theorem ip4w_bip (i : Fin 6) (b : Fin 4 → ℂ) :
    ip4 (w ⟨i.val, by omega⟩) b = b 0 := by
  fin_cases i <;> simp [ip4w_eq, w, wZ, Fin.sum_univ_four]
private theorem b_tail_ne_zero {b : Fin 4 → ℂ} (hb : b ≠ 0) (hb0 : b 0 = 0) :
    (![b 1, b 2, b 3] : Fin 3 → ℂ) ≠ 0 := by
  intro h; apply hb; funext r; fin_cases r
  · exact hb0
  · exact congrArg (fun f : Fin 3 → ℂ => f 0) h
  · exact congrArg (fun f : Fin 3 → ℂ => f 1) h
  · exact congrArg (fun f : Fin 3 → ℂ => f 2) h
private theorem vec3_eq (a : Fin 3 → ℂ) : (![a 0, a 1, a 2] : Fin 3 → ℂ) = a := by
  ext i; fin_cases i <;> rfl
private theorem vec3_ne {a : Fin 3 → ℂ} (ha : a ≠ 0) :
    (![a 0, a 1, a 2] : Fin 3 → ℂ) ≠ 0 := by
  intro h; exact ha ((vec3_eq a).symm.trans h)
private theorem vec4_eq (c : Fin 4 → ℂ) : (![c 0, c 1, c 2, c 3] : Fin 4 → ℂ) = c := by
  ext i; fin_cases i <;> rfl
private theorem vec4_ne {c : Fin 4 → ℂ} (hc : c ≠ 0) :
    (![c 0, c 1, c 2, c 3] : Fin 4 → ℂ) ≠ 0 := by
  intro h; exact hc ((vec4_eq c).symm.trans h)
private theorem form8_u (a : Fin 3 → ℂ) (i : Fin 8) :
    αU8 (a 0) (a 1) (a 2) i = ip3 (u ⟨i.val + 6, by omega⟩) a := by
  fin_cases i <;> simp [αU8, ip3_eq, u, uZ, Fin.sum_univ_three, add_comm, add_left_comm, add_assoc, mul_comm]
private theorem form8_w (b : Fin 4 → ℂ) (hb0 : b 0 = 0) (i : Fin 8) :
    βW8 (b 1) (b 2) (b 3) i = ip4 (w ⟨i.val + 6, by omega⟩) b := by
  fin_cases i <;> simp [βW8, ip4w_eq, w, wZ, Fin.sum_univ_four, hb0, add_comm, add_left_comm, add_assoc, mul_comm]
private theorem form8_z (c : Fin 4 → ℂ) (i : Fin 8) :
    γZ8 (c 0) (c 1) (c 2) (c 3) i = ip4 (z ⟨i.val + 6, by omega⟩) c := by
  fin_cases i <;> simp [γZ8, ip4z_eq, z, zZ, Fin.sum_univ_four, add_comm, add_left_comm, add_assoc, mul_comm]
private theorem form6_u (a : Fin 3 → ℂ) (i : Fin 6) :
    αU6 (a 0) (a 1) (a 2) i = ip3 (u ⟨i.val, by omega⟩) a := by
  fin_cases i <;> simp [αU6, ip3_eq, u, uZ, Fin.sum_univ_three, add_comm, add_left_comm, add_assoc, mul_comm]
private theorem form6_z (c : Fin 4 → ℂ) (i : Fin 6) :
    γZ6 (c 0) (c 1) (c 2) (c 3) i = ip4 (z ⟨i.val, by omega⟩) c := by
  fin_cases i <;> simp [γZ6, ip4z_eq, z, zZ, Fin.sum_univ_four, add_comm, add_left_comm, add_assoc, mul_comm]

set_option maxHeartbeats 4000000 in
theorem unextendible
    (a : Fin 3 → ℂ) (ha : a ≠ 0) (b : Fin 4 → ℂ) (hb : b ≠ 0) (c : Fin 4 → ℂ) (hc : c ≠ 0) :
    ∃ i : Fin 14, ip3 (u i) a * ip4 (w i) b * ip4 (z i) c ≠ 0 := by
  classical
  by_cases hb0 : b 0 = 0
  · have hb' := b_tail_ne_zero hb hb0
    by_contra H; push Not at H
    have E (i : Fin 8) :
        ip3 (u ⟨i.val + 6, by omega⟩) a *
          ip4 (w ⟨i.val + 6, by omega⟩) b *
          ip4 (z ⟨i.val + 6, by omega⟩) c = 0 := H ⟨i.val + 6, by omega⟩
    have e0 : αU8 (a 0) (a 1) (a 2) ⟨0, by decide⟩ *
        βW8 (b 1) (b 2) (b 3) ⟨0, by decide⟩ *
        γZ8 (c 0) (c 1) (c 2) (c 3) ⟨0, by decide⟩ = 0 := by
      have := E ⟨0, by decide⟩; simpa [form8_u, form8_w b hb0, form8_z, mul_assoc, mul_left_comm, mul_comm] using this
    have e1 : αU8 (a 0) (a 1) (a 2) ⟨1, by decide⟩ *
        βW8 (b 1) (b 2) (b 3) ⟨1, by decide⟩ *
        γZ8 (c 0) (c 1) (c 2) (c 3) ⟨1, by decide⟩ = 0 := by
      have := E ⟨1, by decide⟩; simpa [form8_u, form8_w b hb0, form8_z, mul_assoc, mul_left_comm, mul_comm] using this
    have e2 : αU8 (a 0) (a 1) (a 2) ⟨2, by decide⟩ *
        βW8 (b 1) (b 2) (b 3) ⟨2, by decide⟩ *
        γZ8 (c 0) (c 1) (c 2) (c 3) ⟨2, by decide⟩ = 0 := by
      have := E ⟨2, by decide⟩; simpa [form8_u, form8_w b hb0, form8_z, mul_assoc, mul_left_comm, mul_comm] using this
    have e3 : αU8 (a 0) (a 1) (a 2) ⟨3, by decide⟩ *
        βW8 (b 1) (b 2) (b 3) ⟨3, by decide⟩ *
        γZ8 (c 0) (c 1) (c 2) (c 3) ⟨3, by decide⟩ = 0 := by
      have := E ⟨3, by decide⟩; simpa [form8_u, form8_w b hb0, form8_z, mul_assoc, mul_left_comm, mul_comm] using this
    have e4 : αU8 (a 0) (a 1) (a 2) ⟨4, by decide⟩ *
        βW8 (b 1) (b 2) (b 3) ⟨4, by decide⟩ *
        γZ8 (c 0) (c 1) (c 2) (c 3) ⟨4, by decide⟩ = 0 := by
      have := E ⟨4, by decide⟩; simpa [form8_u, form8_w b hb0, form8_z, mul_assoc, mul_left_comm, mul_comm] using this
    have e5 : αU8 (a 0) (a 1) (a 2) ⟨5, by decide⟩ *
        βW8 (b 1) (b 2) (b 3) ⟨5, by decide⟩ *
        γZ8 (c 0) (c 1) (c 2) (c 3) ⟨5, by decide⟩ = 0 := by
      have := E ⟨5, by decide⟩; simpa [form8_u, form8_w b hb0, form8_z, mul_assoc, mul_left_comm, mul_comm] using this
    have e6 : αU8 (a 0) (a 1) (a 2) ⟨6, by decide⟩ *
        βW8 (b 1) (b 2) (b 3) ⟨6, by decide⟩ *
        γZ8 (c 0) (c 1) (c 2) (c 3) ⟨6, by decide⟩ = 0 := by
      have := E ⟨6, by decide⟩; simpa [form8_u, form8_w b hb0, form8_z, mul_assoc, mul_left_comm, mul_comm] using this
    have e7 : αU8 (a 0) (a 1) (a 2) ⟨7, by decide⟩ *
        βW8 (b 1) (b 2) (b 3) ⟨7, by decide⟩ *
        γZ8 (c 0) (c 1) (c 2) (c 3) ⟨7, by decide⟩ = 0 := by
      have := E ⟨7, by decide⟩; simpa [form8_u, form8_w b hb0, form8_z, mul_assoc, mul_left_comm, mul_comm] using this
    exact (unext8 (vec3_ne ha) hb' (vec4_ne hc) e0 e1 e2 e3 e4 e5 e6 e7).elim
  · by_contra H; push Not at H
    have E (i : Fin 6) :
        ip3 (u ⟨i.val, by omega⟩) a *
          ip4 (w ⟨i.val, by omega⟩) b *
          ip4 (z ⟨i.val, by omega⟩) c = 0 := H ⟨i.val, by omega⟩
    have Ei (i : Fin 6) :
        ip3 (u ⟨i.val, by omega⟩) a * ip4 (z ⟨i.val, by omega⟩) c = 0 := by
      have h := E i
      have hw : ip4 (w ⟨i.val, by omega⟩) b = b 0 := ip4w_bip i b
      rw [hw] at h
      have : (ip3 (u ⟨i.val, by omega⟩) a * ip4 (z ⟨i.val, by omega⟩) c) * b 0 = 0 := by
        simpa [mul_assoc, mul_left_comm, mul_comm] using h
      exact (mul_eq_zero.1 this).resolve_right hb0
    have f0 : αU6 (a 0) (a 1) (a 2) ⟨0, by decide⟩ * γZ6 (c 0) (c 1) (c 2) (c 3) ⟨0, by decide⟩ = 0 := by
      have := Ei ⟨0, by decide⟩; simpa [form6_u, form6_z] using this
    have f1 : αU6 (a 0) (a 1) (a 2) ⟨1, by decide⟩ * γZ6 (c 0) (c 1) (c 2) (c 3) ⟨1, by decide⟩ = 0 := by
      have := Ei ⟨1, by decide⟩; simpa [form6_u, form6_z] using this
    have f2 : αU6 (a 0) (a 1) (a 2) ⟨2, by decide⟩ * γZ6 (c 0) (c 1) (c 2) (c 3) ⟨2, by decide⟩ = 0 := by
      have := Ei ⟨2, by decide⟩; simpa [form6_u, form6_z] using this
    have f3 : αU6 (a 0) (a 1) (a 2) ⟨3, by decide⟩ * γZ6 (c 0) (c 1) (c 2) (c 3) ⟨3, by decide⟩ = 0 := by
      have := Ei ⟨3, by decide⟩; simpa [form6_u, form6_z] using this
    have f4 : αU6 (a 0) (a 1) (a 2) ⟨4, by decide⟩ * γZ6 (c 0) (c 1) (c 2) (c 3) ⟨4, by decide⟩ = 0 := by
      have := Ei ⟨4, by decide⟩; simpa [form6_u, form6_z] using this
    have f5 : αU6 (a 0) (a 1) (a 2) ⟨5, by decide⟩ * γZ6 (c 0) (c 1) (c 2) (c 3) ⟨5, by decide⟩ = 0 := by
      have := Ei ⟨5, by decide⟩; simpa [form6_u, form6_z] using this
    exact (unext6 (vec3_ne ha) (vec4_ne hc) f0 f1 f2 f3 f4 f5).elim

theorem proof :
    ∃ u : Fin 14 → Fin 3 → ℂ,
    ∃ w : Fin 14 → Fin 4 → ℂ,
    ∃ z : Fin 14 → Fin 4 → ℂ,
      (∀ i, u i ≠ 0) ∧ (∀ i, w i ≠ 0) ∧ (∀ i, z i ≠ 0) ∧
      (∀ i j, i ≠ j →
        (∑ r, star (u i r) * u j r) *
        (∑ r, star (w i r) * w j r) *
        (∑ r, star (z i r) * z j r) = 0) ∧
      (∀ a : Fin 3 → ℂ, a ≠ 0 → ∀ b : Fin 4 → ℂ, b ≠ 0 →
        ∀ c : Fin 4 → ℂ, c ≠ 0 →
        ∃ i,
          (∑ r, star (u i r) * a r) *
          (∑ r, star (w i r) * b r) *
          (∑ r, star (z i r) * c r) ≠ 0) := by
  refine ⟨u, w, z, u_ne, w_ne, z_ne, ?ortho, ?unext⟩
  · intro i j hij; simpa [ip3, ip4] using pairwise_ortho i j hij
  · intro a ha b hb c hc; simpa [ip3, ip4] using unextendible a ha b hb c hc

