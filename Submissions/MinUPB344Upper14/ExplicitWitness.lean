  | ⟨0, _⟩ => ((-6) : ℂ) * c0 + ((-2) : ℂ) * c1 + ((8) : ℂ) * c2 + ((6) : ℂ) * c3
  | ⟨1, _⟩ => ((-3) : ℂ) * c0 + ((23) : ℂ) * c1 + ((20) : ℂ) * c2 + ((-13) : ℂ) * c3
  | ⟨2, _⟩ => ((0) : ℂ) * c0 + ((1) : ℂ) * c1 + ((1) : ℂ) * c2 + ((-1) : ℂ) * c3
  | ⟨3, _⟩ => ((0) : ℂ) * c0 + ((-2) : ℂ) * c1 + ((1) : ℂ) * c2 + ((-2) : ℂ) * c3
  | ⟨4, _⟩ => ((-14) : ℂ) * c0 + ((0) : ℂ) * c1 + ((-6) : ℂ) * c2 + ((-6) : ℂ) * c3
  | ⟨5, _⟩ => ((6) : ℂ) * c0 + ((-1) : ℂ) * c1 + ((4) : ℂ) * c2 + ((3) : ℂ) * c3
